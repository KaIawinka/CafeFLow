generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================================
// ENUMS
// ==========================================================

enum tenant_status {
  trial
  active
  suspended
  archived
}

enum branch_status {
  active
  inactive
}

enum file_purpose {
  logo
  product
  banner
  document
  avatar
  other
}

enum user_role {
  customer
  employee
  kitchen
  manager
  admin
}

enum user_status {
  active
  blocked
  pending
}

enum cart_status {
  active
  converted
  abandoned
}

enum fulfillment_type {
  pickup
  delivery
  dine_in
}

enum order_status {
  new
  confirmed
  cooking
  ready
  delivering
  completed
  cancelled
}

// NOTE: в исходном docx это же имя "payment_status" использовалось дважды
// с разными значениями (для orders и для payments). Разделено на два enum:
enum order_payment_status {
  pending
  paid
  failed
  refunded
  partial
}

enum payment_txn_status {
  pending
  authorized
  paid
  failed
  refunded
}

enum delivery_status {
  pending
  assigned
  delivering
  delivered
  failed
}

enum payment_method {
  cash
  card
  online
  other
}

enum payment_operation {
  authorize
  capture
  refund
  void
}

enum table_status {
  active
  inactive
}

enum reservation_status {
  pending
  confirmed
  seated
  completed
  cancelled
  no_show
}

enum loyalty_operation {
  earn
  spend
  expire
  adjust
}

enum promotion_type {
  percent
  fixed
  bonus
  free_delivery
}

enum notification_channel {
  email
  sms
  push
  in_app
}

enum notification_type {
  order_status
  reservation
  marketing
  system
}

enum notification_status {
  queued
  sent
  failed
  read
}

enum review_status {
  pending
  published
  rejected
}

enum content_type {
  page
  banner
  faq
}

enum ai_request_status {
  queued
  processing
  completed
  failed
}

// ==========================================================
// 1. tenants
// ==========================================================
model tenants {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @db.VarChar(200)
  slug          String        @unique @db.VarChar(100)
  status        tenant_status
  currency      String        @db.Char(3)
  timezone      String        @db.VarChar(64)
  logo_file_id  String?       @db.Uuid
  primary_color String?       @db.VarChar(20)
  contact_phone String?       @db.VarChar(40)
  contact_email String?       @db.VarChar(255)
  address_text  String?
  latitude      Decimal?      @db.Decimal(9, 6)
  longitude     Decimal?      @db.Decimal(9, 6)
  settings      Json?
  created_at    DateTime      @default(now()) @db.Timestamptz
  updated_at    DateTime      @updatedAt @db.Timestamptz

  logo_file          files?               @relation("tenant_logo_file", fields: [logo_file_id], references: [id])
  branches           branches[]
  files              files[]              @relation("tenant_files")
  users              users[]
  menu_categories    menu_categories[]
  products           products[]
  carts              carts[]
  orders             orders[]
  customer_addresses customer_addresses[]
  delivery_zones     delivery_zones[]
  payments           payments[]
  restaurant_tables  restaurant_tables[]
  reservations       reservations[]
  table_blocks       table_blocks[]
  loyalty            loyalty[]
  promotions         promotions[]
  favorites          favorites[]
  notifications      notifications[]
  reviews            reviews[]
  content            content[]
  business_hours     business_hours[]
  activity_logs      activity_logs[]
  ai_requests        ai_requests[]
  analytics_daily    analytics_daily[]
}

// ==========================================================
// 2. branches
// ==========================================================
model branches {
  id           String        @id @default(uuid()) @db.Uuid
  tenant_id    String        @db.Uuid
  name         String        @db.VarChar(200)
  code         String        @db.VarChar(50)
  address_text String?
  phone        String?       @db.VarChar(40)
  timezone     String?       @db.VarChar(64)
  status       branch_status
  created_at   DateTime      @default(now()) @db.Timestamptz
  updated_at   DateTime      @updatedAt @db.Timestamptz

  tenant tenants @relation(fields: [tenant_id], references: [id])

  users             users[]
  orders            orders[]
  delivery_zones    delivery_zones[]
  restaurant_tables restaurant_tables[]
  reservations      reservations[]
  table_blocks      table_blocks[]
  business_hours    business_hours[]
  analytics_daily   analytics_daily[]

  @@index([tenant_id])
}

// ==========================================================
// 3. files
// ==========================================================
model files {
  id            String        @id @default(uuid()) @db.Uuid
  tenant_id     String?       @db.Uuid
  storage_key   String        @unique @db.VarChar(500)
  original_name String?       @db.VarChar(255)
  mime_type     String        @db.VarChar(120)
  size_bytes    BigInt
  purpose       file_purpose?
  uploaded_by   String?       @db.Uuid
  created_at    DateTime      @default(now()) @db.Timestamptz

  tenant   tenants? @relation("tenant_files", fields: [tenant_id], references: [id])
  uploader users?   @relation("uploaded_files", fields: [uploaded_by], references: [id])

  tenants_logo   tenants[] @relation("tenant_logo_file")
  users_avatar   users[]   @relation("user_avatar_file")
  content_images content[] @relation("content_image_file")

  @@index([tenant_id])
}

// ==========================================================
// 4. users
// ==========================================================
model users {
  id                String      @id @default(uuid()) @db.Uuid
  tenant_id         String?     @db.Uuid
  branch_id         String?     @db.Uuid
  email             String?     @db.VarChar(255)
  phone             String?     @db.VarChar(40)
  password_hash     String?
  first_name        String?     @db.VarChar(100)
  last_name         String?     @db.VarChar(100)
  display_name      String?     @db.VarChar(150)
  avatar_file_id    String?     @db.Uuid
  role              user_role
  status            user_status
  email_verified_at DateTime?   @db.Timestamptz
  phone_verified_at DateTime?   @db.Timestamptz
  last_login_at     DateTime?   @db.Timestamptz

  // Telegram 2FA fields
  telegram_chat_id  String? @unique @db.VarChar(100)
  telegram_username String? @db.VarChar(100)
  two_fa_enabled    Boolean @default(false)
  two_fa_secret     String? @db.VarChar(255)

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  tenant      tenants?  @relation(fields: [tenant_id], references: [id])
  branch      branches? @relation(fields: [branch_id], references: [id])
  avatar_file files?    @relation("user_avatar_file", fields: [avatar_file_id], references: [id])

  uploaded_files     files[]              @relation("uploaded_files")
  carts              carts[]
  orders             orders[]
  customer_addresses customer_addresses[]
  reservations       reservations[]
  loyalty            loyalty[]
  favorites          favorites[]
  notifications      notifications[]
  reviews            reviews[]
  activity_logs      activity_logs[]
  ai_requests        ai_requests[]
  auth_sessions      auth_sessions[]
  verification_codes verification_codes[]
  login_attempts     login_attempts[]

  @@index([tenant_id])
  @@index([branch_id])
  @@index([email])
  @@index([telegram_chat_id])
}

// ==========================================================
// 5. menu_categories
// ==========================================================
model menu_categories {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  parent_id   String?  @db.Uuid
  name        String   @db.VarChar(150)
  slug        String   @db.VarChar(150)
  description String?
  sort_order  Int
  is_active   Boolean
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  tenant   tenants           @relation(fields: [tenant_id], references: [id])
  parent   menu_categories?  @relation("category_parent", fields: [parent_id], references: [id])
  children menu_categories[] @relation("category_parent")

  products products[]

  @@index([tenant_id])
}

// ==========================================================
// 6. products
// ==========================================================
model products {
  id                  String    @id @default(uuid()) @db.Uuid
  tenant_id           String    @db.Uuid
  category_id         String?   @db.Uuid
  name                String    @db.VarChar(200)
  slug                String    @db.VarChar(200)
  description         String?
  composition         String?
  price               Decimal   @db.Decimal(12, 2)
  currency            String    @db.Char(3)
  weight              Decimal?  @db.Decimal(10, 3)
  image_file_ids      Json?
  modifiers           Json?
  allergens           Json?
  is_available        Boolean
  is_featured         Boolean
  sort_order          Int
  preparation_minutes Int?
  created_at          DateTime  @default(now()) @db.Timestamptz
  updated_at          DateTime  @updatedAt @db.Timestamptz
  deleted_at          DateTime? @db.Timestamptz

  tenant   tenants          @relation(fields: [tenant_id], references: [id])
  category menu_categories? @relation(fields: [category_id], references: [id])

  order_items order_items[]
  favorites   favorites[]
  reviews     reviews[]

  @@index([tenant_id])
  @@index([category_id])
}

// ==========================================================
// 7. carts
// ==========================================================
model carts {
  id          String      @id @default(uuid()) @db.Uuid
  tenant_id   String      @db.Uuid
  user_id     String?     @db.Uuid
  session_key String?     @db.VarChar(120)
  branch_id   String?     @db.Uuid
  status      cart_status
  items       Json
  subtotal    Decimal     @db.Decimal(12, 2)
  updated_at  DateTime    @updatedAt @db.Timestamptz

  tenant tenants @relation(fields: [tenant_id], references: [id])
  user   users?  @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([user_id])
}

// ==========================================================
// 8. orders
// ==========================================================
model orders {
  id               String               @id @default(uuid()) @db.Uuid
  tenant_id        String               @db.Uuid
  branch_id        String?              @db.Uuid
  order_number     String               @db.VarChar(40)
  user_id          String?              @db.Uuid
  customer_name    String               @db.VarChar(200)
  customer_phone   String               @db.VarChar(40)
  customer_email   String?              @db.VarChar(255)
  fulfillment_type fulfillment_type
  status           order_status
  payment_status   order_payment_status
  subtotal         Decimal              @db.Decimal(12, 2)
  discount_total   Decimal              @db.Decimal(12, 2)
  delivery_fee     Decimal              @db.Decimal(12, 2)
  total            Decimal              @db.Decimal(12, 2)
  currency         String               @db.Char(3)
  desired_at       DateTime?            @db.Timestamptz
  comment          String?
  delivery_address Json?
  idempotency_key  String?              @db.VarChar(120)
  status_history   Json?
  problem          String?
  created_at       DateTime             @default(now()) @db.Timestamptz
  updated_at       DateTime             @updatedAt @db.Timestamptz
  completed_at     DateTime?            @db.Timestamptz
  cancelled_at     DateTime?            @db.Timestamptz

  tenant tenants   @relation(fields: [tenant_id], references: [id])
  branch branches? @relation(fields: [branch_id], references: [id])
  user   users?    @relation(fields: [user_id], references: [id])

  order_items     order_items[]
  order_delivery  order_deliveries?
  payment         payments?
  loyalty_entries loyalty[]
  reviews         reviews[]

  @@unique([tenant_id, order_number])
  @@index([branch_id])
  @@index([user_id])
}

// ==========================================================
// 9. order_items
// ==========================================================
model order_items {
  id              String  @id @default(uuid()) @db.Uuid
  order_id        String  @db.Uuid
  product_id      String? @db.Uuid
  product_name    String  @db.VarChar(200)
  unit_price      Decimal @db.Decimal(12, 2)
  quantity        Int
  modifiers       Json?
  modifiers_total Decimal @db.Decimal(12, 2)
  discount_amount Decimal @db.Decimal(12, 2)
  line_total      Decimal @db.Decimal(12, 2)
  comment         String?

  order   orders    @relation(fields: [order_id], references: [id])
  product products? @relation(fields: [product_id], references: [id])

  @@index([order_id])
  @@index([product_id])
}

// ==========================================================
// 10. customer_addresses
// ==========================================================
model customer_addresses {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  user_id      String   @db.Uuid
  label        String?  @db.VarChar(80)
  address_text String
  entrance     String?  @db.VarChar(30)
  floor        String?  @db.VarChar(20)
  apartment    String?  @db.VarChar(20)
  comment      String?
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  is_default   Boolean
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz

  tenant tenants @relation(fields: [tenant_id], references: [id])
  user   users   @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([user_id])
}

// ==========================================================
// 11. delivery_zones
// ==========================================================
model delivery_zones {
  id                String  @id @default(uuid()) @db.Uuid
  tenant_id         String  @db.Uuid
  branch_id         String? @db.Uuid
  name              String  @db.VarChar(150)
  min_order_amount  Decimal @db.Decimal(12, 2)
  delivery_fee      Decimal @db.Decimal(12, 2)
  estimated_minutes Int?
  is_active         Boolean
  rules             Json?

  tenant tenants   @relation(fields: [tenant_id], references: [id])
  branch branches? @relation(fields: [branch_id], references: [id])

  order_deliveries order_deliveries[]

  @@index([tenant_id])
  @@index([branch_id])
}

// ==========================================================
// 12. order_deliveries
// ==========================================================
model order_deliveries {
  id               String          @id @default(uuid()) @db.Uuid
  order_id         String          @unique @db.Uuid
  zone_id          String?         @db.Uuid
  address_snapshot Json
  status           delivery_status
  courier_name     String?         @db.VarChar(150)
  courier_phone    String?         @db.VarChar(40)
  tracking_code    String?         @db.VarChar(100)
  delivered_at     DateTime?       @db.Timestamptz
  created_at       DateTime        @default(now()) @db.Timestamptz

  order orders          @relation(fields: [order_id], references: [id])
  zone  delivery_zones? @relation(fields: [zone_id], references: [id])

  @@index([zone_id])
}

// ==========================================================
// 13. payments
// ==========================================================
model payments {
  id                  String             @id @default(uuid()) @db.Uuid
  tenant_id           String             @db.Uuid
  order_id            String             @unique @db.Uuid
  method              payment_method
  provider            String?            @db.VarChar(50)
  provider_payment_id String?            @db.VarChar(150)
  amount              Decimal            @db.Decimal(12, 2)
  currency            String             @db.Char(3)
  status              payment_txn_status
  operation           payment_operation?
  provider_event_id   String?            @db.VarChar(150)
  provider_payload    Json?
  paid_at             DateTime?          @db.Timestamptz
  created_at          DateTime           @default(now()) @db.Timestamptz
  updated_at          DateTime           @updatedAt @db.Timestamptz

  tenant tenants @relation(fields: [tenant_id], references: [id])
  order  orders  @relation(fields: [order_id], references: [id])

  @@unique([provider, provider_event_id])
  @@index([tenant_id])
}

// ==========================================================
// 14. restaurant_tables
// ==========================================================
model restaurant_tables {
  id        String       @id @default(uuid()) @db.Uuid
  tenant_id String       @db.Uuid
  branch_id String       @db.Uuid
  zone      String?      @db.VarChar(100)
  name      String       @db.VarChar(80)
  capacity  Int
  status    table_status
  position  Json?

  tenant tenants  @relation(fields: [tenant_id], references: [id])
  branch branches @relation(fields: [branch_id], references: [id])

  table_blocks table_blocks[]

  @@index([tenant_id])
  @@index([branch_id])
}

// ==========================================================
// 15. reservations
// ==========================================================
model reservations {
  id            String             @id @default(uuid()) @db.Uuid
  tenant_id     String             @db.Uuid
  branch_id     String             @db.Uuid
  user_id       String?            @db.Uuid
  guest_name    String             @db.VarChar(200)
  guest_phone   String             @db.VarChar(40)
  guest_email   String?            @db.VarChar(255)
  guests_count  Int
  start_at      DateTime           @db.Timestamptz
  end_at        DateTime           @db.Timestamptz
  status        reservation_status
  table_ids     Json?
  comment       String?
  cancel_reason String?
  created_at    DateTime           @default(now()) @db.Timestamptz
  updated_at    DateTime           @updatedAt @db.Timestamptz

  tenant tenants  @relation(fields: [tenant_id], references: [id])
  branch branches @relation(fields: [branch_id], references: [id])
  user   users?   @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([branch_id])
  @@index([user_id])
}

// ==========================================================
// 16. table_blocks
// ==========================================================
model table_blocks {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  branch_id  String   @db.Uuid
  table_id   String   @db.Uuid
  start_at   DateTime @db.Timestamptz
  end_at     DateTime @db.Timestamptz
  reason     String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamptz

  tenant tenants           @relation(fields: [tenant_id], references: [id])
  branch branches          @relation(fields: [branch_id], references: [id])
  table  restaurant_tables @relation(fields: [table_id], references: [id])

  @@index([tenant_id])
  @@index([branch_id])
  @@index([table_id])
}

// ==========================================================
// 17. loyalty
// ==========================================================
model loyalty {
  id         String             @id @default(uuid()) @db.Uuid
  tenant_id  String             @db.Uuid
  user_id    String             @unique @db.Uuid
  balance    Decimal            @db.Decimal(12, 2)
  operation  loyalty_operation?
  amount     Decimal?           @db.Decimal(12, 2)
  order_id   String?            @db.Uuid
  comment    String?
  created_at DateTime           @default(now()) @db.Timestamptz

  tenant tenants @relation(fields: [tenant_id], references: [id])
  user   users   @relation(fields: [user_id], references: [id])
  order  orders? @relation(fields: [order_id], references: [id])

  @@index([tenant_id])
  @@index([order_id])
}

// ==========================================================
// 18. promotions
// ==========================================================
model promotions {
  id               String         @id @default(uuid()) @db.Uuid
  tenant_id        String         @db.Uuid
  code             String?        @db.VarChar(80)
  name             String         @db.VarChar(200)
  description      String?
  type             promotion_type
  value            Decimal        @db.Decimal(12, 2)
  min_order_amount Decimal?       @db.Decimal(12, 2)
  max_discount     Decimal?       @db.Decimal(12, 2)
  starts_at        DateTime?      @db.Timestamptz
  ends_at          DateTime?      @db.Timestamptz
  usage_limit      Int?
  usage_count      Int
  product_ids      Json?
  category_ids     Json?
  is_active        Boolean
  created_at       DateTime       @default(now()) @db.Timestamptz

  tenant tenants @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, code])
  @@index([tenant_id])
}

// ==========================================================
// 19. favorites
// ==========================================================
model favorites {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  user_id    String   @db.Uuid
  product_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz

  tenant  tenants  @relation(fields: [tenant_id], references: [id])
  user    users    @relation(fields: [user_id], references: [id])
  product products @relation(fields: [product_id], references: [id])

  @@unique([user_id, product_id])
  @@index([tenant_id])
}

// ==========================================================
// 20. notifications
// ==========================================================
model notifications {
  id           String               @id @default(uuid()) @db.Uuid
  tenant_id    String?              @db.Uuid
  user_id      String?              @db.Uuid
  channel      notification_channel
  type         notification_type
  subject      String?              @db.VarChar(255)
  body         String
  status       notification_status
  attempts     Int
  last_error   String?
  scheduled_at DateTime?            @db.Timestamptz
  sent_at      DateTime?            @db.Timestamptz
  read_at      DateTime?            @db.Timestamptz
  created_at   DateTime             @default(now()) @db.Timestamptz

  tenant tenants? @relation(fields: [tenant_id], references: [id])
  user   users?   @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([user_id])
}

// ==========================================================
// 21. reviews
// ==========================================================
model reviews {
  id          String        @id @default(uuid()) @db.Uuid
  tenant_id   String        @db.Uuid
  user_id     String?       @db.Uuid
  order_id    String?       @db.Uuid
  product_id  String?       @db.Uuid
  rating      Int           @db.SmallInt
  text        String?
  status      review_status
  admin_reply String?
  created_at  DateTime      @default(now()) @db.Timestamptz
  updated_at  DateTime      @updatedAt @db.Timestamptz

  tenant  tenants   @relation(fields: [tenant_id], references: [id])
  user    users?    @relation(fields: [user_id], references: [id])
  order   orders?   @relation(fields: [order_id], references: [id])
  product products? @relation(fields: [product_id], references: [id])

  @@index([tenant_id])
}

// ==========================================================
// 22. content
// ==========================================================
model content {
  id            String       @id @default(uuid()) @db.Uuid
  tenant_id     String       @db.Uuid
  type          content_type
  title         String       @db.VarChar(255)
  slug          String?      @db.VarChar(255)
  content       String?
  image_file_id String?      @db.Uuid
  sort_order    Int
  is_active     Boolean
  metadata      Json?
  created_at    DateTime     @default(now()) @db.Timestamptz
  updated_at    DateTime     @updatedAt @db.Timestamptz

  tenant     tenants @relation(fields: [tenant_id], references: [id])
  image_file files?  @relation("content_image_file", fields: [image_file_id], references: [id])

  @@index([tenant_id])
}

// ==========================================================
// 23. business_hours
// ==========================================================
model business_hours {
  id               String    @id @default(uuid()) @db.Uuid
  tenant_id        String    @db.Uuid
  branch_id        String?   @db.Uuid
  day_of_week      Int       @db.SmallInt
  open_time        DateTime? @db.Time
  close_time       DateTime? @db.Time
  is_closed        Boolean
  exception_date   DateTime? @db.Date
  exception_reason String?   @db.VarChar(255)
  created_at       DateTime  @default(now()) @db.Timestamptz

  tenant tenants   @relation(fields: [tenant_id], references: [id])
  branch branches? @relation(fields: [branch_id], references: [id])

  @@index([tenant_id])
  @@index([branch_id])
}

// ==========================================================
// 24. activity_logs
// ==========================================================
model activity_logs {
  id            String   @id @default(uuid()) @db.Uuid
  tenant_id     String?  @db.Uuid
  actor_user_id String?  @db.Uuid
  action        String   @db.VarChar(80)
  entity_type   String?  @db.VarChar(80)
  entity_id     String?  @db.Uuid
  before_data   Json?
  after_data    Json?
  ip_address    String?  @db.Inet
  user_agent    String?
  created_at    DateTime @default(now()) @db.Timestamptz

  tenant tenants? @relation(fields: [tenant_id], references: [id])
  actor  users?   @relation(fields: [actor_user_id], references: [id])

  @@index([tenant_id])
  @@index([actor_user_id])
}

// ==========================================================
// 25. ai_requests
// ==========================================================
model ai_requests {
  id            String            @id @default(uuid()) @db.Uuid
  tenant_id     String?           @db.Uuid
  user_id       String?           @db.Uuid
  feature       String            @db.VarChar(80)
  provider      String?           @db.VarChar(50)
  model         String?           @db.VarChar(100)
  input_data    Json?
  output_data   Json?
  status        ai_request_status
  tokens_in     Int?
  tokens_out    Int?
  latency_ms    Int?
  error_message String?
  created_at    DateTime          @default(now()) @db.Timestamptz

  tenant tenants? @relation(fields: [tenant_id], references: [id])
  user   users?   @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([user_id])
}

// ==========================================================
// 26. analytics_daily
// ==========================================================
model analytics_daily {
  id                 String   @id @default(uuid()) @db.Uuid
  tenant_id          String   @db.Uuid
  branch_id          String?  @db.Uuid
  date               DateTime @db.Date
  orders_count       Int
  completed_orders   Int
  cancelled_orders   Int
  revenue            Decimal  @db.Decimal(14, 2)
  discount_total     Decimal  @db.Decimal(14, 2)
  delivery_revenue   Decimal  @db.Decimal(14, 2)
  new_customers      Int
  reservations_count Int
  created_at         DateTime @default(now()) @db.Timestamptz

  tenant tenants   @relation(fields: [tenant_id], references: [id])
  branch branches? @relation(fields: [branch_id], references: [id])

  @@unique([tenant_id, branch_id, date])
  @@index([tenant_id])
}

// ==========================================================
// 27. auth_sessions
// ==========================================================
model auth_sessions {
  id              String   @id @default(uuid()) @db.Uuid
  user_id         String   @db.Uuid
  token           String   @unique @db.VarChar(500)
  expires_at      DateTime @db.Timestamptz
  ip_address      String?  @db.Inet
  user_agent      String?  @db.VarChar(500)
  is_2fa_verified Boolean  @default(false)
  last_activity   DateTime @default(now()) @db.Timestamptz
  created_at      DateTime @default(now()) @db.Timestamptz

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token])
  @@index([expires_at])
}

// ==========================================================
// 28. verification_codes
// ==========================================================
model verification_codes {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  code       String    @db.VarChar(10)
  type       String    @db.VarChar(50)
  expires_at DateTime  @db.Timestamptz
  used_at    DateTime? @db.Timestamptz
  attempts   Int       @default(0) @db.SmallInt
  ip_address String?   @db.Inet
  created_at DateTime  @default(now()) @db.Timestamptz

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([code])
  @@index([expires_at])
  @@index([type])
}

// ==========================================================
// 29. login_attempts
// ==========================================================
model login_attempts {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @db.VarChar(255)
  ip_address String   @db.Inet
  user_agent String?  @db.VarChar(500)
  success    Boolean
  reason     String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamptz
  users      users?   @relation(fields: [usersId], references: [id])
  usersId    String?  @db.Uuid

  @@index([email])
  @@index([ip_address])
  @@index([created_at])
}

// ==========================================================
// 30. telegram_link_codes
// ==========================================================
model telegram_link_codes {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  code       String    @unique @db.VarChar(50)
  expires_at DateTime  @db.Timestamptz
  used_at    DateTime? @db.Timestamptz
  created_at DateTime  @default(now()) @db.Timestamptz

  @@index([code])
  @@index([user_id])
  @@index([expires_at])
}
