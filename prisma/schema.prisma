generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model tenants {
  id                 String               @id @default(uuid()) @db.Uuid
  name               String               @db.VarChar(200)
  slug               String               @unique @db.VarChar(100)
  status             tenant_status
  currency           String               @db.Char(3)
  timezone           String               @db.VarChar(64)
  logo_file_id       String?              @db.Uuid
  primary_color      String?              @db.VarChar(20)
  contact_phone      String?              @db.VarChar(40)
  contact_email      String?              @db.VarChar(255)
  address_text       String?
  latitude           Decimal?             @db.Decimal(9, 6)
  longitude          Decimal?             @db.Decimal(9, 6)
  settings           Json?
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @updatedAt @db.Timestamptz(6)
  activity_logs      activity_logs[]
  ai_requests        ai_requests[]
  analytics_daily    analytics_daily[]
  branches           branches[]
  business_hours     business_hours[]
  carts              carts[]
  content            content[]
  customer_addresses customer_addresses[]
  delivery_zones     delivery_zones[]
  favorites          favorites[]
  files              files[]              @relation("tenant_files")
  loyalty            loyalty[]
  menu_categories    menu_categories[]
  notifications      notifications[]
  orders             orders[]
  payments           payments[]
  products           products[]
  promotions         promotions[]
  reservations       reservations[]
  restaurant_tables  restaurant_tables[]
  reviews            reviews[]
  table_blocks       table_blocks[]
  tenant_domains     tenant_domains[]
  logo_file          files?               @relation("tenant_logo_file", fields: [logo_file_id], references: [id])
  users              users[]
}

model tenant_domains {
  id          String        @id @default(uuid()) @db.Uuid
  tenant_id   String        @db.Uuid
  hostname    String        @unique @db.VarChar(255)
  status      domain_status @default(pending)
  verification_token String  @unique @db.VarChar(120)
  verified_at DateTime?     @db.Timestamptz(6)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime      @updatedAt @db.Timestamptz(6)
  tenant      tenants       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([hostname, status])
}

model contact_leads {
  id         String       @id @default(uuid()) @db.Uuid
  name       String       @db.VarChar(160)
  email      String       @db.VarChar(255)
  phone      String?      @db.VarChar(40)
  company    String?      @db.VarChar(200)
  message    String?
  status     lead_status  @default(new)
  ip_address String?      @db.Inet
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  updated_at DateTime     @updatedAt @db.Timestamptz(6)

  @@index([email])
  @@index([status, created_at])
}

model branches {
  id                String              @id @default(uuid()) @db.Uuid
  tenant_id         String              @db.Uuid
  name              String              @db.VarChar(200)
  code              String              @db.VarChar(50)
  address_text      String?
  phone             String?             @db.VarChar(40)
  timezone          String?             @db.VarChar(64)
  status            branch_status
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @updatedAt @db.Timestamptz(6)
  analytics_daily   analytics_daily[]
  tenant            tenants             @relation(fields: [tenant_id], references: [id])
  business_hours    business_hours[]
  delivery_zones    delivery_zones[]
  orders            orders[]
  reservations      reservations[]
  restaurant_tables restaurant_tables[]
  table_blocks      table_blocks[]
  users             users[]

  @@index([tenant_id])
}

model files {
  id             String        @id @default(uuid()) @db.Uuid
  tenant_id      String?       @db.Uuid
  storage_key    String        @unique @db.VarChar(500)
  original_name  String?       @db.VarChar(255)
  mime_type      String        @db.VarChar(120)
  size_bytes     BigInt
  purpose        file_purpose?
  uploaded_by    String?       @db.Uuid
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  content_images content[]     @relation("content_image_file")
  tenant         tenants?      @relation("tenant_files", fields: [tenant_id], references: [id])
  uploader       users?        @relation("uploaded_files", fields: [uploaded_by], references: [id])
  tenants_logo   tenants[]     @relation("tenant_logo_file")
  users_avatar   users[]       @relation("user_avatar_file")

  @@index([tenant_id])
}

model users {
  id                          String                @id @default(uuid()) @db.Uuid
  tenant_id                   String?               @db.Uuid
  branch_id                   String?               @db.Uuid
  email                       String                @unique @db.VarChar(255)
  phone                       String?               @db.VarChar(40)
  password_hash               String
  first_name                  String                @db.VarChar(100)
  last_name                   String?               @db.VarChar(100)
  display_name                String?               @db.VarChar(150)
  avatar_file_id              String?               @db.Uuid
  bio                         String?
  role                        user_role             @default(customer)
  status                      user_status           @default(active)
  email_verified_at           DateTime?             @db.Timestamptz(6)
  phone_verified_at           DateTime?             @db.Timestamptz(6)
  telegram_chat_id            String?               @unique @db.VarChar(100)
  telegram_username           String?               @db.VarChar(100)
  telegram_activated_with_key String?               @db.VarChar(50)
  two_fa_enabled              Boolean               @default(false)
  two_fa_secret               String?               @db.VarChar(255)
  requires_approval           Boolean               @default(false)
  language                    String                @default("ru") @db.VarChar(5)
  timezone                    String                @default("Asia/Bishkek") @db.VarChar(50)
  last_login_at               DateTime?             @db.Timestamptz(6)
  last_seen_at                DateTime?             @db.Timestamptz(6)
  created_at                  DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime              @updatedAt @db.Timestamptz(6)
  approved_requests           access_requests[]     @relation("approved_requests")
  access_requests             access_requests[]     @relation("access_requests")
  activity_logs               activity_logs[]
  ai_requests                 ai_requests[]
  auth_sessions               auth_sessions[]
  bot_access_keys             bot_access_keys[]
  bot_key_activations         bot_key_activations[]
  carts                       carts[]
  customer_addresses          customer_addresses[]
  favorites                   favorites[]
  uploaded_files              files[]               @relation("uploaded_files")
  login_attempts              login_attempts[]
  loyalty                     loyalty?
  notifications               notifications[]
  orders                      orders[]
  reservations                reservations[]
  reviews                     reviews[]
  user_settings               user_settings?
  avatar_file                 files?                @relation("user_avatar_file", fields: [avatar_file_id], references: [id])
  branch                      branches?             @relation(fields: [branch_id], references: [id])
  tenant                      tenants?              @relation(fields: [tenant_id], references: [id])
  verification_codes          verification_codes[]

  @@index([tenant_id])
  @@index([branch_id])
  @@index([email])
  @@index([role])
  @@index([status])
  @@index([telegram_chat_id])
}

model menu_categories {
  id          String            @id @default(uuid()) @db.Uuid
  tenant_id   String            @db.Uuid
  parent_id   String?           @db.Uuid
  name        String            @db.VarChar(150)
  slug        String            @db.VarChar(150)
  description String?
  sort_order  Int
  is_active   Boolean
  created_at  DateTime          @default(now()) @db.Timestamptz(6)
  updated_at  DateTime          @updatedAt @db.Timestamptz(6)
  parent      menu_categories?  @relation("category_parent", fields: [parent_id], references: [id])
  children    menu_categories[] @relation("category_parent")
  tenant      tenants           @relation(fields: [tenant_id], references: [id])
  products    products[]

  @@index([tenant_id])
}

model products {
  id                  String           @id @default(uuid()) @db.Uuid
  tenant_id           String           @db.Uuid
  category_id         String?          @db.Uuid
  name                String           @db.VarChar(200)
  slug                String           @db.VarChar(200)
  description         String?
  composition         String?
  price               Decimal          @db.Decimal(12, 2)
  currency            String           @db.Char(3)
  weight              Decimal?         @db.Decimal(10, 3)
  image_file_ids      Json?
  modifiers           Json?
  allergens           Json?
  is_available        Boolean
  is_featured         Boolean
  sort_order          Int
  preparation_minutes Int?
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime         @updatedAt @db.Timestamptz(6)
  deleted_at          DateTime?        @db.Timestamptz(6)
  favorites           favorites[]
  order_items         order_items[]
  category            menu_categories? @relation(fields: [category_id], references: [id])
  tenant              tenants          @relation(fields: [tenant_id], references: [id])
  reviews             reviews[]

  @@index([tenant_id])
  @@index([category_id])
}

model carts {
  id          String      @id @default(uuid()) @db.Uuid
  tenant_id   String      @db.Uuid
  user_id     String?     @db.Uuid
  session_key String?     @db.VarChar(120)
  branch_id   String?     @db.Uuid
  status      cart_status
  items       Json
  subtotal    Decimal     @db.Decimal(12, 2)
  updated_at  DateTime    @updatedAt @db.Timestamptz(6)
  tenant      tenants     @relation(fields: [tenant_id], references: [id])
  user        users?      @relation(fields: [user_id], references: [id])

  @@unique([tenant_id, session_key])
  @@index([tenant_id])
  @@index([user_id])
}

model orders {
  id               String               @id @default(uuid()) @db.Uuid
  tenant_id        String               @db.Uuid
  branch_id        String?              @db.Uuid
  order_number     String               @db.VarChar(40)
  user_id          String?              @db.Uuid
  customer_name    String               @db.VarChar(200)
  customer_phone   String               @db.VarChar(40)
  customer_email   String?              @db.VarChar(255)
  fulfillment_type fulfillment_type
  status           order_status
  payment_status   order_payment_status
  subtotal         Decimal              @db.Decimal(12, 2)
  discount_total   Decimal              @db.Decimal(12, 2)
  delivery_fee     Decimal              @db.Decimal(12, 2)
  total            Decimal              @db.Decimal(12, 2)
  currency         String               @db.Char(3)
  desired_at       DateTime?            @db.Timestamptz(6)
  comment          String?
  delivery_address Json?
  idempotency_key  String?              @db.VarChar(120)
  status_history   Json?
  problem          String?
  guest_token      String?              @unique @db.VarChar(120)
  created_at       DateTime             @default(now()) @db.Timestamptz(6)
  updated_at       DateTime             @updatedAt @db.Timestamptz(6)
  completed_at     DateTime?            @db.Timestamptz(6)
  cancelled_at     DateTime?            @db.Timestamptz(6)
  loyalty_entries  loyalty[]
  order_delivery   order_deliveries?
  order_items      order_items[]
  branch           branches?            @relation(fields: [branch_id], references: [id])
  tenant           tenants              @relation(fields: [tenant_id], references: [id])
  user             users?               @relation(fields: [user_id], references: [id])
  payment          payments?
  reviews          reviews[]

  @@unique([tenant_id, order_number])
  @@unique([tenant_id, idempotency_key])
  @@index([branch_id])
  @@index([user_id])
}

model order_items {
  id              String    @id @default(uuid()) @db.Uuid
  order_id        String    @db.Uuid
  product_id      String?   @db.Uuid
  product_name    String    @db.VarChar(200)
  unit_price      Decimal   @db.Decimal(12, 2)
  quantity        Int
  modifiers       Json?
  modifiers_total Decimal   @db.Decimal(12, 2)
  discount_amount Decimal   @db.Decimal(12, 2)
  line_total      Decimal   @db.Decimal(12, 2)
  comment         String?
  order           orders    @relation(fields: [order_id], references: [id])
  product         products? @relation(fields: [product_id], references: [id])

  @@index([order_id])
  @@index([product_id])
}

model customer_addresses {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  user_id      String   @db.Uuid
  label        String?  @db.VarChar(80)
  address_text String
  entrance     String?  @db.VarChar(30)
  floor        String?  @db.VarChar(20)
  apartment    String?  @db.VarChar(20)
  comment      String?
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  is_default   Boolean
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)
  tenant       tenants  @relation(fields: [tenant_id], references: [id])
  user         users    @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([user_id])
}

model delivery_zones {
  id                String             @id @default(uuid()) @db.Uuid
  tenant_id         String             @db.Uuid
  branch_id         String?            @db.Uuid
  name              String             @db.VarChar(150)
  min_order_amount  Decimal            @db.Decimal(12, 2)
  delivery_fee      Decimal            @db.Decimal(12, 2)
  estimated_minutes Int?
  is_active         Boolean
  rules             Json?
  branch            branches?          @relation(fields: [branch_id], references: [id])
  tenant            tenants            @relation(fields: [tenant_id], references: [id])
  order_deliveries  order_deliveries[]

  @@index([tenant_id])
  @@index([branch_id])
}

model order_deliveries {
  id               String          @id @default(uuid()) @db.Uuid
  order_id         String          @unique @db.Uuid
  zone_id          String?         @db.Uuid
  address_snapshot Json
  status           delivery_status
  courier_name     String?         @db.VarChar(150)
  courier_phone    String?         @db.VarChar(40)
  tracking_code    String?         @db.VarChar(100)
  delivered_at     DateTime?       @db.Timestamptz(6)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  order            orders          @relation(fields: [order_id], references: [id])
  zone             delivery_zones? @relation(fields: [zone_id], references: [id])

  @@index([zone_id])
}

model payments {
  id                  String             @id @default(uuid()) @db.Uuid
  tenant_id           String             @db.Uuid
  order_id            String             @unique @db.Uuid
  method              payment_method
  provider            String?            @db.VarChar(50)
  provider_payment_id String?            @db.VarChar(150)
  amount              Decimal            @db.Decimal(12, 2)
  currency            String             @db.Char(3)
  status              payment_txn_status
  operation           payment_operation?
  provider_event_id   String?            @db.VarChar(150)
  provider_payload    Json?
  paid_at             DateTime?          @db.Timestamptz(6)
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  updated_at          DateTime           @updatedAt @db.Timestamptz(6)
  order               orders             @relation(fields: [order_id], references: [id])
  tenant              tenants            @relation(fields: [tenant_id], references: [id])

  @@unique([provider, provider_event_id])
  @@index([tenant_id])
}

model restaurant_tables {
  id           String         @id @default(uuid()) @db.Uuid
  tenant_id    String         @db.Uuid
  branch_id    String         @db.Uuid
  zone         String?        @db.VarChar(100)
  name         String         @db.VarChar(80)
  capacity     Int
  status       table_status
  position     Json?
  branch       branches       @relation(fields: [branch_id], references: [id])
  tenant       tenants        @relation(fields: [tenant_id], references: [id])
  table_blocks table_blocks[]

  @@index([tenant_id])
  @@index([branch_id])
}

model reservations {
  id            String             @id @default(uuid()) @db.Uuid
  tenant_id     String             @db.Uuid
  branch_id     String             @db.Uuid
  user_id       String?            @db.Uuid
  guest_name    String             @db.VarChar(200)
  guest_phone   String             @db.VarChar(40)
  guest_email   String?            @db.VarChar(255)
  guests_count  Int
  start_at      DateTime           @db.Timestamptz(6)
  end_at        DateTime           @db.Timestamptz(6)
  status        reservation_status
  table_ids     Json?
  comment       String?
  cancel_reason String?
  guest_token   String?   @unique @db.VarChar(120)
  created_at    DateTime           @default(now()) @db.Timestamptz(6)
  updated_at    DateTime           @updatedAt @db.Timestamptz(6)
  branch        branches           @relation(fields: [branch_id], references: [id])
  tenant        tenants            @relation(fields: [tenant_id], references: [id])
  user          users?             @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([branch_id])
  @@index([user_id])
}

model table_blocks {
  id         String            @id @default(uuid()) @db.Uuid
  tenant_id  String            @db.Uuid
  branch_id  String            @db.Uuid
  table_id   String            @db.Uuid
  start_at   DateTime          @db.Timestamptz(6)
  end_at     DateTime          @db.Timestamptz(6)
  reason     String?           @db.VarChar(255)
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  branch     branches          @relation(fields: [branch_id], references: [id])
  table      restaurant_tables @relation(fields: [table_id], references: [id])
  tenant     tenants           @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([branch_id])
  @@index([table_id])
}

model loyalty {
  id         String             @id @default(uuid()) @db.Uuid
  tenant_id  String             @db.Uuid
  user_id    String             @unique @db.Uuid
  balance    Decimal            @db.Decimal(12, 2)
  operation  loyalty_operation?
  amount     Decimal?           @db.Decimal(12, 2)
  order_id   String?            @db.Uuid
  comment    String?
  created_at DateTime           @default(now()) @db.Timestamptz(6)
  order      orders?            @relation(fields: [order_id], references: [id])
  tenant     tenants            @relation(fields: [tenant_id], references: [id])
  user       users              @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([order_id])
}

model promotions {
  id               String         @id @default(uuid()) @db.Uuid
  tenant_id        String         @db.Uuid
  code             String?        @db.VarChar(80)
  name             String         @db.VarChar(200)
  description      String?
  type             promotion_type
  value            Decimal        @db.Decimal(12, 2)
  min_order_amount Decimal?       @db.Decimal(12, 2)
  max_discount     Decimal?       @db.Decimal(12, 2)
  starts_at        DateTime?      @db.Timestamptz(6)
  ends_at          DateTime?      @db.Timestamptz(6)
  usage_limit      Int?
  usage_count      Int
  product_ids      Json?
  category_ids     Json?
  is_active        Boolean
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  tenant           tenants        @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, code])
  @@index([tenant_id])
}

model favorites {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  user_id    String   @db.Uuid
  product_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  product    products @relation(fields: [product_id], references: [id])
  tenant     tenants  @relation(fields: [tenant_id], references: [id])
  user       users    @relation(fields: [user_id], references: [id])

  @@unique([user_id, product_id])
  @@index([tenant_id])
}

model notifications {
  id           String               @id @default(uuid()) @db.Uuid
  tenant_id    String?              @db.Uuid
  user_id      String?              @db.Uuid
  channel      notification_channel
  type         notification_type
  subject      String?              @db.VarChar(255)
  body         String
  status       notification_status
  attempts     Int
  last_error   String?
  scheduled_at DateTime?            @db.Timestamptz(6)
  sent_at      DateTime?            @db.Timestamptz(6)
  read_at      DateTime?            @db.Timestamptz(6)
  created_at   DateTime             @default(now()) @db.Timestamptz(6)
  tenant       tenants?             @relation(fields: [tenant_id], references: [id])
  user         users?               @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([user_id])
}

model reviews {
  id          String        @id @default(uuid()) @db.Uuid
  tenant_id   String        @db.Uuid
  user_id     String?       @db.Uuid
  order_id    String?       @db.Uuid
  product_id  String?       @db.Uuid
  rating      Int           @db.SmallInt
  text        String?
  status      review_status
  admin_reply String?
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime      @updatedAt @db.Timestamptz(6)
  order       orders?       @relation(fields: [order_id], references: [id])
  product     products?     @relation(fields: [product_id], references: [id])
  tenant      tenants       @relation(fields: [tenant_id], references: [id])
  user        users?        @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
}

model content {
  id            String       @id @default(uuid()) @db.Uuid
  tenant_id     String       @db.Uuid
  type          content_type
  title         String       @db.VarChar(255)
  slug          String?      @db.VarChar(255)
  content       String?
  image_file_id String?      @db.Uuid
  sort_order    Int
  is_active     Boolean
  metadata      Json?
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @updatedAt @db.Timestamptz(6)
  image_file    files?       @relation("content_image_file", fields: [image_file_id], references: [id])
  tenant        tenants      @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
}

model business_hours {
  id               String    @id @default(uuid()) @db.Uuid
  tenant_id        String    @db.Uuid
  branch_id        String?   @db.Uuid
  day_of_week      Int       @db.SmallInt
  open_time        DateTime? @db.Time(6)
  close_time       DateTime? @db.Time(6)
  is_closed        Boolean
  exception_date   DateTime? @db.Date
  exception_reason String?   @db.VarChar(255)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  branch           branches? @relation(fields: [branch_id], references: [id])
  tenant           tenants   @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([branch_id])
}

model activity_logs {
  id            String   @id @default(uuid()) @db.Uuid
  tenant_id     String?  @db.Uuid
  actor_user_id String?  @db.Uuid
  action        String   @db.VarChar(80)
  entity_type   String?  @db.VarChar(80)
  entity_id     String?  @db.Uuid
  before_data   Json?
  after_data    Json?
  ip_address    String?  @db.Inet
  user_agent    String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  actor         users?   @relation(fields: [actor_user_id], references: [id])
  tenant        tenants? @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([actor_user_id])
}

model ai_requests {
  id            String            @id @default(uuid()) @db.Uuid
  tenant_id     String?           @db.Uuid
  user_id       String?           @db.Uuid
  feature       String            @db.VarChar(80)
  provider      String?           @db.VarChar(50)
  model         String?           @db.VarChar(100)
  input_data    Json?
  output_data   Json?
  status        ai_request_status
  tokens_in     Int?
  tokens_out    Int?
  latency_ms    Int?
  error_message String?
  created_at    DateTime          @default(now()) @db.Timestamptz(6)
  tenant        tenants?          @relation(fields: [tenant_id], references: [id])
  user          users?            @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([user_id])
}

model analytics_daily {
  id                 String    @id @default(uuid()) @db.Uuid
  tenant_id          String    @db.Uuid
  branch_id          String?   @db.Uuid
  date               DateTime  @db.Date
  orders_count       Int
  completed_orders   Int
  cancelled_orders   Int
  revenue            Decimal   @db.Decimal(14, 2)
  discount_total     Decimal   @db.Decimal(14, 2)
  delivery_revenue   Decimal   @db.Decimal(14, 2)
  new_customers      Int
  reservations_count Int
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  branch             branches? @relation(fields: [branch_id], references: [id])
  tenant             tenants   @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, branch_id, date])
  @@index([tenant_id])
}

model auth_sessions {
  id              String   @id @default(uuid()) @db.Uuid
  user_id         String   @db.Uuid
  token           String   @unique @db.VarChar(500)
  expires_at      DateTime @db.Timestamptz(6)
  ip_address      String?  @db.Inet
  user_agent      String?  @db.VarChar(500)
  is_2fa_verified Boolean  @default(false)
  last_activity   DateTime @default(now()) @db.Timestamptz(6)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  user            users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token])
  @@index([expires_at])
}

model verification_codes {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  code       String    @db.VarChar(10)
  type       String    @db.VarChar(50)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  attempts   Int       @default(0) @db.SmallInt
  ip_address String?   @db.Inet
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([code])
  @@index([expires_at])
  @@index([type])
}

model login_attempts {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @db.VarChar(255)
  ip_address String   @db.Inet
  user_agent String?  @db.VarChar(500)
  success    Boolean
  reason     String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  usersId    String?  @db.Uuid
  users      users?   @relation(fields: [usersId], references: [id])

  @@index([email])
  @@index([ip_address])
  @@index([created_at])
}

model telegram_link_codes {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  code       String    @unique @db.VarChar(50)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([code])
  @@index([user_id])
  @@index([expires_at])
}

model settings {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       String
  description String?
  is_public   Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  @@index([key])
}

model access_requests {
  id               String                @id @default(uuid()) @db.Uuid
  user_id          String                @db.Uuid
  request_token    String                @unique @db.VarChar(100)
  status           access_request_status @default(pending)
  ip_address       String?               @db.Inet
  user_agent       String?               @db.VarChar(500)
  device_info      Json?
  location         String?               @db.VarChar(200)
  approved_by      String?               @db.Uuid
  approved_at      DateTime?             @db.Timestamptz(6)
  rejection_reason String?               @db.VarChar(255)
  session_token    String?               @db.VarChar(500)
  expires_at       DateTime              @db.Timestamptz(6)
  created_at       DateTime              @default(now()) @db.Timestamptz(6)
  updated_at       DateTime              @updatedAt @db.Timestamptz(6)
  approved_by_user users?                @relation("approved_requests", fields: [approved_by], references: [id])
  user             users                 @relation("access_requests", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([request_token])
  @@index([status])
  @@index([expires_at])
  @@index([created_at])
}

model bot_access_keys {
  id          String                @id @default(uuid()) @db.Uuid
  key         String                @unique @db.VarChar(50)
  key_type    String                @db.VarChar(20)
  description String?               @db.VarChar(255)
  max_uses    Int?
  uses_count  Int                   @default(0)
  expires_at  DateTime?             @db.Timestamptz(6)
  is_active   Boolean               @default(true)
  created_by  String                @db.Uuid
  created_at  DateTime              @default(now()) @db.Timestamptz(6)
  updated_at  DateTime              @updatedAt @db.Timestamptz(6)
  creator     users                 @relation(fields: [created_by], references: [id])
  activations bot_key_activations[]

  @@index([key])
  @@index([key_type])
  @@index([is_active])
}

model bot_key_activations {
  id               String          @id @default(uuid()) @db.Uuid
  key_id           String          @db.Uuid
  user_id          String          @db.Uuid
  telegram_chat_id String          @db.VarChar(100)
  activated_at     DateTime        @default(now()) @db.Timestamptz(6)
  key              bot_access_keys @relation(fields: [key_id], references: [id])
  user             users           @relation(fields: [user_id], references: [id])

  @@index([key_id])
  @@index([user_id])
}

model user_settings {
  id                     String   @id @default(uuid()) @db.Uuid
  user_id                String   @unique @db.Uuid
  email_notifications    Boolean  @default(true)
  sms_notifications      Boolean  @default(false)
  push_notifications     Boolean  @default(true)
  telegram_notifications Boolean  @default(true)
  show_online_status     Boolean  @default(true)
  show_phone             Boolean  @default(false)
  show_email             Boolean  @default(false)
  theme                  String   @default("light") @db.VarChar(20)
  compact_mode           Boolean  @default(false)
  created_at             DateTime @default(now()) @db.Timestamptz(6)
  updated_at             DateTime @updatedAt @db.Timestamptz(6)
  user                   users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

